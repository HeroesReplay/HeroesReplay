{
    // Use IntelliSense to find out which attributes exist for C# debugging
    // Use hover for the description of the existing attributes
    // For further information visit https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HOTS API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/HeroesReplay.CLI/bin/Debug/net10.0-windows10.0.19041.0/heroesreplay.exe",
            "args": ["--launch=true"],
            "env": {
                "HEROES_REPLAY_AWS_ACCESS_KEY": "",
                "HEROES_REPLAY_AWS_SECRET_KEY": ""
            },
            "cwd": "${workspaceFolder}/src/HeroesReplay.CLI",
            "console": "externalTerminal",
            "stopAtEntry": true
        },
        {
            "name": "REPLAY NO LAUNCH",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/HeroesReplay.CLI/bin/Debug/net10.0-windows10.0.19041.0/heroesreplay.exe",
            "args": [
                "directory|file|hotsapi",
                "--launch=",
                "--path=",
                "--bnet="
            ],
            "cwd": "${workspaceFolder}/src/HeroesReplay.CLI",
            "console": "externalTerminal",
            "stopAtEntry": true
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}