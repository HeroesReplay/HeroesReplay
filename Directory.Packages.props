<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <!--
        HeroesClientSDK (the memory match clock and screen state) is restored from the .packages
        folder (nuget.config). tools/restore-sdk-package.ps1 downloads the release asset for this
        version from github.com/HeroesReplay/HeroesClientSDK without authentication and checks this
        SHA-256 before it places the file. Bump both together. The pin is exact: a bump is a
        match-clock change (AGENTS.md).
    -->
    <PropertyGroup>
        <HeroesClientSDKVersion>0.4.0</HeroesClientSDKVersion>
        <HeroesClientSDKSha256>9a63a2440386f62c5885afc759fe58f1584080405484f74f4280dd887890f647</HeroesClientSDKSha256>
    </PropertyGroup>
    <ItemGroup>
        <!-- .NET 10 LTS -->
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
        <PackageVersion
            Include="Microsoft.Extensions.Configuration.EnvironmentVariables"
            Version="10.0.12"
        />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageVersion
            Include="Microsoft.Extensions.FileProviders.Abstractions"
            Version="10.0.12"
        />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
        <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
        <PackageVersion Include="System.Net.Http.Json" Version="10.0.12" />

        <PackageVersion Include="System.CommandLine" Version="2.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />

        <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />

        <PackageVersion Include="Google.Apis.YouTube.v3" Version="1.76.0.4262" />
        <PackageVersion Include="Heroes.Element" Version="1.0.3" />
        <PackageVersion Include="Heroes.ReplayParser" Version="1.2.18" />
        <PackageVersion Include="Microsoft.Kiota.Bundle" Version="1.22.2" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="obs-websocket-dotnet" Version="5.7.0" />
        <PackageVersion Include="PInvoke.User32" Version="0.7.124" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
        <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.10.0" />
        <PackageVersion Include="TwitchLib" Version="3.5.3" />

        <PackageVersion Include="HeroesClientSDK" Version="[$(HeroesClientSDKVersion)]" />

        <PackageVersion Include="FluentAssertions" Version="8.11.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
        <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    </ItemGroup>
</Project>
