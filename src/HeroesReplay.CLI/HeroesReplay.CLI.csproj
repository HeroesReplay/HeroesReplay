<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <StartupObject />
        <AssemblyName>heroesreplay</AssemblyName>
        <IsPackable>false</IsPackable>
        <ApplicationIcon>heroesreplay.ico</ApplicationIcon>
        <UseWindowsForms>true</UseWindowsForms>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Microsoft.Extensions.Logging.EventLog" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HeroesReplay.Core\HeroesReplay.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.dev.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.prod.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.secrets.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\..\tools\apply-release.ps1">
            <Link>apply-release.ps1</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\tools\ensure-secrets.ps1;..\..\tools\fill-secrets-from-op.ps1">
            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <!-- Production agent runbook and MCP configs. Publish only, so a dev bin never carries the prod AGENTS.md. -->
        <None Include="..\..\deploy\production\AGENTS.md;..\..\deploy\production\CLAUDE.md;..\..\deploy\production\.mcp.json">
            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\..\deploy\production\.grok\config.toml">
            <Link>.grok\config.toml</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\..\obs\interfaces\AhliObs 0.75.StormInterface">
            <Link>Assets\Interfaces\AhliObs 0.75.StormInterface</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="IncludeObsBundle" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <_ObsManifest>$(MSBuildThisFileDirectory)..\..\obs\bundle.manifest</_ObsManifest>
            <_ObsDirectory>$(MSBuildThisFileDirectory)..\..\obs\</_ObsDirectory>
        </PropertyGroup>
        <ReadLinesFromFile File="$(_ObsManifest)">
            <Output TaskParameter="Lines" ItemName="_ObsBundleLine" />
        </ReadLinesFromFile>
        <ItemGroup>
            <_ObsBundleLine
                Remove="@(_ObsBundleLine)"
                Condition="'%(_ObsBundleLine.Identity)' == '' or $([System.String]::Copy('%(_ObsBundleLine.Identity)').StartsWith('#'))"
            />
            <Content
                Include="$(_ObsDirectory)%(_ObsBundleLine.Identity)"
                Link="obs\$([System.String]::Copy('%(_ObsBundleLine.Identity)').Replace('/','\'))"
                CopyToPublishDirectory="PreserveNewest"
                CopyToOutputDirectory="Never"
                Condition="Exists('$(_ObsDirectory)%(_ObsBundleLine.Identity)')"
            />
        </ItemGroup>
    </Target>
</Project>
