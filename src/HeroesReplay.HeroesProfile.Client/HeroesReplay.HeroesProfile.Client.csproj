        <TargetFramework>net10.0</TargetFramework>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <NoWarn>$(NoWarn);CS1591;CS8618;CS8632</NoWarn>
        <RootNamespace>HeroesReplay.HeroesProfile.Client</RootNamespace>
        <Description>
