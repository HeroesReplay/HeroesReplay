root = true

# Unused code fails the build. Other analyzer warnings stay warnings.
# CA1812 (uninstantiated internal class) is off: the DI container and the
# IRewardHandler / IMessageHandler assembly scan construct types the compiler
# never sees with `new`. UnusedSourceTests is the check for unused types.
[*.cs]
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.CA1811.severity = error
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CS0168.severity = error
dotnet_diagnostic.CS0169.severity = error
dotnet_diagnostic.CS0219.severity = error
dotnet_diagnostic.CS0414.severity = error
dotnet_diagnostic.CS8321.severity = error

[src/HeroesReplay.HeroesProfile.Client/Generated/**.cs]
generated_code = true

[**/obj/**.cs]
generated_code = true

[**/*.g.cs]
generated_code = true

[**/*.AssemblyInfo.cs]
generated_code = true
