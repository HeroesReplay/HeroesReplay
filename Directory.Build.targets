<Project>
    <Target
        Name="CSharpierCheck"
        AfterTargets="Build"
        Condition="'$(CSharpierCheck)' == 'true' AND '$(DesignTimeBuild)' != 'true'"
    >
        <Exec
            Command="dotnet csharpier check ."
            WorkingDirectory="$(MSBuildThisFileDirectory)"
            IgnoreExitCode="false"
        />
    </Target>

    <Target
        Name="InstallGitHooks"
        BeforeTargets="Build"
        Condition="'$(DesignTimeBuild)' != 'true' AND '$(CI)' != 'true' AND '$(GITHUB_ACTIONS)' != 'true' AND '$(MSBuildProjectName)' == 'HeroesReplay.CLI'"
    >
        <Exec
            Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)tools\install-git-hooks.ps1&quot;"
        />
    </Target>
</Project>
