<?xml version="1.0" encoding="utf-8"?>
<!--
  HeroesClientSDK (the memory match clock and screen state) comes from the gitignored .packages
  folder. tools/restore-sdk-package.ps1 fills it from the public GitHub Release asset, with no
  credentials, and checks the SHA-256 pinned in Directory.Packages.props. The build runs it when
  the file is missing. Every other package comes from nuget.org.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="heroesclientsdk" value=".packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="heroesclientsdk">
            <package pattern="HeroesClientSDK" />
        </packageSource>
    </packageSourceMapping>
</configuration>
