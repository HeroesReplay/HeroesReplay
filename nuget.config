<?xml version="1.0" encoding="utf-8"?>
<!--
  HeroesClientSDK (the memory match clock and screen state) comes from GitHub Packages. Every other
  package comes from nuget.org. GitHub Packages needs a token with read:packages even for a public
  package: CI authenticates the github source with GITHUB_TOKEN, and a workstation stores its
  token in the user-level NuGet config (tools/bootstrap-workstation.ps1). Never put a token here.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="github" value="https://nuget.pkg.github.com/HeroesReplay/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="HeroesClientSDK" />
        </packageSource>
    </packageSourceMapping>
</configuration>
